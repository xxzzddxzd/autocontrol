{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "autocontrol 进度事件 v1（进度管道中的一行）",
  "type": "object",
  "required": [
    "v",
    "kind",
    "seq",
    "ts"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "enum": [
        "plan",
        "task_started",
        "task_progress",
        "task_finished",
        "task_failed"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "同一进程内严格递增"
    },
    "ts": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Unix 时间戳（秒）"
    },
    "run": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "进程实例标识"
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "服务日 YYYY-MM-DD"
    },
    "tasks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "not_started",
              "incomplete",
              "running",
              "complete",
              "waiting",
              "blocked",
              "failed",
              "result_unavailable",
              "unsupported",
              "closed"
            ],
            "description": "十种标准状态之一"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "description": "标准原因码或清单 reasons 中声明的原因码"
          },
          "current": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 1,
            "description": "只有真实分母时才上报"
          },
          "unit": {
            "type": "string",
            "maxLength": 4
          },
          "next_run_at": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Unix 时间戳（秒）"
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            },
            "description": "清单 count_keys 中声明的计数"
          }
        }
      }
    },
    "next_wake": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Unix 时间戳（秒）"
      },
      "description": "未来需要再次检查的时间（服务器计时到期、窗口开放等）"
    },
    "task": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "status": {
      "enum": [
        "not_started",
        "incomplete",
        "running",
        "complete",
        "waiting",
        "blocked",
        "failed",
        "result_unavailable",
        "unsupported",
        "closed"
      ],
      "description": "十种标准状态之一"
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "description": "标准原因码或清单 reasons 中声明的原因码"
    },
    "current": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 1,
      "description": "只有真实分母时才上报"
    },
    "unit": {
      "type": "string",
      "maxLength": 4
    },
    "next_run_at": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Unix 时间戳（秒）"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "清单 count_keys 中声明的计数"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plan"
          }
        }
      },
      "then": {
        "required": [
          "tasks"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "task_started",
              "task_progress",
              "task_finished",
              "task_failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "task"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task_finished"
          }
        }
      },
      "then": {
        "required": [
          "status"
        ]
      }
    }
  ],
  "description": "UTF-8 JSON，一行一个事件，含换行不超过 4096 字节"
}
