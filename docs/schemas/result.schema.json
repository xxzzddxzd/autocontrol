{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "autocontrol 最终结果 v1（stdout 最后一行）",
  "type": "object",
  "required": [
    "v",
    "phase",
    "day",
    "outcome"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "phase": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "服务日 YYYY-MM-DD"
    },
    "outcome": {
      "enum": [
        "complete",
        "partial",
        "waiting",
        "failed",
        "busy",
        "skipped"
      ]
    },
    "failure_stage": {
      "enum": [
        "config",
        "lock",
        "login",
        "connect",
        "read",
        "execute",
        "write"
      ]
    },
    "error_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"
    },
    "tasks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "not_started",
              "incomplete",
              "running",
              "complete",
              "waiting",
              "blocked",
              "failed",
              "result_unavailable",
              "unsupported",
              "closed"
            ],
            "description": "十种标准状态之一"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "description": "标准原因码或清单 reasons 中声明的原因码"
          },
          "current": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 1,
            "description": "只有真实分母时才上报"
          },
          "unit": {
            "type": "string",
            "maxLength": 4
          },
          "next_run_at": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Unix 时间戳（秒）"
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            },
            "description": "清单 count_keys 中声明的计数"
          }
        }
      }
    },
    "next_wake": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Unix 时间戳（秒）"
      },
      "description": "未来需要再次检查的时间（服务器计时到期、窗口开放等）"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions_sent": {
          "type": "integer",
          "minimum": 0,
          "description": "发出的变更请求数（领取、购买、提交等）"
        },
        "actions_confirmed": {
          "type": "integer",
          "minimum": 0,
          "description": "收到成功回执的变更请求数"
        },
        "actions_failed": {
          "type": "integer",
          "minimum": 0,
          "description": "被明确拒绝或失败的变更请求数"
        },
        "actions_unconfirmed": {
          "type": "integer",
          "minimum": 0,
          "description": "已发出但未收到结果的变更请求数"
        },
        "reads": {
          "type": "integer",
          "minimum": 0,
          "description": "只读查询请求数"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "description": "重试次数（含重连）"
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "description": "本次新建的登录会话或连接数"
        }
      }
    },
    "run_scope": {
      "type": "object",
      "description": "本轮下一阶段原样收到（仅清单 run_scope=true）"
    }
  }
}
